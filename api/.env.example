# Copy to api/.env and fill in. Never commit api/.env.

DATABASE_URL=postgresql+psycopg://veylith:veylith@localhost:5432/veylith

# Your OWN GitHub OAuth App for local dev (github.com/settings/developers)
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Where the browser reaches the app
WEB_URL=http://localhost:3000
# Public URL GitHub sends webhooks to (your own smee.io / tunnel URL in local dev)
WEBHOOK_URL=

# Run the scan worker loop inside the API process
RUN_WORKER=1
